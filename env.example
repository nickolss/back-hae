# Variáveis de ambiente da API (configure no Render; NUNCA commite valores reais).

# --- Banco (Neon) — use a URL JDBC com sslmode=require
DATABASE_URL=jdbc:postgresql://<host>.neon.tech/<db>?sslmode=require
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=5

# --- Sessão
# Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_TTL=PT2H
SESSION_COOKIE_NAME=__Host-hae_session
SESSION_COOKIE_SECURE=true

# --- Front-end (links nos e-mails) e CORS. CORS é obrigatório mesmo com o proxy da Vercel (o navegador envia o
# Origin do front). Aceita padrões: inclua os previews, ex.: https://<projeto>-*-<time>.vercel.app
FRONTEND_URL=https://<seu-projeto>.vercel.app
CORS_ALLOWED_ORIGINS=https://<seu-projeto>.vercel.app

# --- E-mail (Gmail: use uma "senha de app")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
FEEDBACK_EMAIL=

# --- Armazenamento de comprovantes (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Cadastro
# Domínios aceitos no autocadastro, separados por vírgula (vazio = qualquer)
REGISTRATION_ALLOWED_DOMAINS=fatec.sp.gov.br,cps.sp.gov.br

# --- Primeiro administrador (criado apenas se não existir nenhum ADMIN)
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Modo demonstração (dados fictícios para apresentações)
# Cria uma unidade, cursos, usuários e HAEs de exemplo na primeira inicialização. Senha das contas de demo:
DEMO_MODE=false
DEMO_PASSWORD=

# --- Diversos
API_DOCS_PUBLIC=false
RATE_LIMIT_AUTH_PER_MINUTE=10
LOG_FORMAT=ecs
